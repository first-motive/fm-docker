# Image inheritance. Every layer is FROM the one above it, so a change to the
# base rebuilds everything below — which is why this repo publishes only the base
# and its GPU variant, and why the tags it publishes are pinned by digest downstream.
...@styles
direction: down

base: "fm-docker base\nros:humble | jazzy + tooling + viz + xacro/rsp" { class: node }
gpu: "fm-docker jazzy-gpu\nFROM base + nvidia env + egl" { class: node }
robot: "fm-robot\nFROM base + ros2_control" { class: pkg }
sim: "fm-sim\nFROM robot + mujoco / gz / xvfb" { class: art }
teleop: "fm-teleop\nFROM robot + moveit / servo" { class: art }
app: "fm-app\nFROM robot + sim & teleop deps + textual" { class: art }

base -> robot
base -> gpu
robot -> sim
robot -> teleop
robot -> app
